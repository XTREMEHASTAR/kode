# AuraCore System Configurations
PORT=3000

# Supabase Credentials (from settings)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API key for multimodal video analysis
GEMINI_API_KEY=your-gemini-api-key

# AI Provider Selection: auto | ollama | gemini
AI_PROVIDER=auto

# Ollama Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:7b

# Gemini Settings
GEMINI_MODEL=gemini-1.5-flash

# Optional AI engine settings
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_ENABLE_FALLBACK=true
