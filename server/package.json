{
  "name": "kontagi-server",
  "version": "1.0.0",
  "description": "Kontagi production backend — Express + TypeScript + Prisma",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t kontagi-server .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "docker:restart": "docker compose restart app",
    "db:backup": "sh scripts/backup/backup.sh",
    "db:restore": "sh scripts/backup/restore.sh",
    "health": "curl -s http://localhost:3000/healthz | node -e \"process.stdin.on('data',d=>{const j=JSON.parse(d);console.log(j.data.status);process.exit(j.success?0:1)})\"",
    "ready": "curl -s http://localhost:3000/readyz | node -e \"process.stdin.on('data',d=>{const j=JSON.parse(d);console.log(JSON.stringify(j.data.checks,null,2));process.exit(j.success?0:1)})\""
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@sentry/node": "^9.27.0",
    "argon2": "^0.44.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "nodemailer": "^9.0.3",
    "pino": "^9.8.0",
    "pino-http": "^10.5.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
