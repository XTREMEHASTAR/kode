# ──────────────────────────────────────────────
# Kontagi Backend — Environment Configuration
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/kontagi?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace-with-64-char-random-secret-here-must-be-32-chars-minimum
JWT_REFRESH_SECRET=replace-with-64-char-random-secret-here-must-be-32-chars-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CSRF
CSRF_SECRET=replace-with-64-char-random-secret-here-must-be-32-chars-minimum

# Billing & Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Token Expiry
VERIFY_TOKEN_EXPIRES_HOURS=24
RESET_TOKEN_EXPIRES_MINUTES=60

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# AI Gateway
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_FALLBACK_MODEL=llama3.2:1b
AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_MS=180000
AI_STREAM_TIMEOUT_MS=300000
AI_MAX_RETRIES=2
AI_QUEUE_CONCURRENCY=3

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Kontagi
SMTP_FROM_EMAIL=noreply@kontagi.com

# App
APP_URL=http://localhost:5173
APP_NAME=Kontagi
